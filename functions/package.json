{
  "name": "mr4-ponto-functions",
  "version": "1.0.0",
  "description": "Cloud Functions — MR4 Ponto Digital",
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "test": "node ../scripts/testes/rodar.js",
    "test:rules": "node ../scripts/testes/rodar.js -- --testPathPattern=rules.test --forceExit",
    "test:unit": "node ../scripts/testes/rodar.js --puro -- --testPathPattern=functions.unit.test --forceExit",
    "test:e2e": "node ../scripts/testes/rodar.js -- --testPathPattern=emulator.e2e.test --forceExit --testTimeout=60000",
    "test:timezone": "node ../scripts/testes/rodar.js --puro -- --testPathPattern=timezone.test --forceExit",
    "test:puro": "node ../scripts/testes/rodar.js --puro"
  },
  "dependencies": {
    "firebase-admin": "^12.3.0",
    "firebase-functions": "^6.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase-tools": "^13.13.0",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "setupFiles": [
      "<rootDir>/test/_ambiente/guarda.js"
    ],
    "globalSetup": "<rootDir>/test/_ambiente/identidade.js"
  },
  "private": true
}
