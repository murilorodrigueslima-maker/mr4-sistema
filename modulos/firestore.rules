// firestore.rules — MR4 Ponto Digital
// Versão: 2026-09-24 (P0 fix: Camila dual-role ponto — temAcessoModulo nas collections ponto)
//
// ANTES DE PUBLICAR EM PRODUÇÃO:
//   1. Execute os testes A-T no emulador (functions/test/).
//   2. Crie docs users/{uid} com role='gestor', ativo=true para os gestores existentes.
//      Sem isso, gestores serão barrados pela regra FAIL CLOSED abaixo.
//   3. Teste no Rules Playground do Firebase Console antes de aplicar.
//
// Perfis:
//   gestor      — acesso total (requer doc users/{uid} com role='gestor' e ativo=true)
//   funcionario — acesso limitado ao próprio funcId
//                 + acesso admin com dual-role (role='funcionario' + sistema_usuarios válido)
//
// Criação de registros de ponto:
//   Funcionários NÃO podem criar registros diretamente.
//   Toda criação é feita pela Cloud Function registrarPonto (Admin SDK).
//   Gestores podem criar registros manualmente (lançamento).

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Funções auxiliares ─────────────────────────────────────────────────────

    function isAuthed() {
      return request.auth != null;
    }

    function meuPerfil() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // FAIL CLOSED: exige doc users/{uid} com role='gestor' E ativo=true.
    // Qualquer usuário sem este doc é tratado como não-gestor.
    // (Anterior: !exists(...) = gestor — VULNERABILIDADE REMOVIDA)
    function isGestor() {
      return isAuthed() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        meuPerfil().role == 'gestor' &&
        meuPerfil().ativo == true;
    }

    // Funcionário ativo: autenticado, role='funcionario', ativo=true
    function isFuncionario() {
      return isAuthed() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        meuPerfil().role == 'funcionario' &&
        meuPerfil().ativo == true;
    }

    // Retorna o funcionarioId vinculado ao UID do funcionário logado
    function meuFuncId() {
      return meuPerfil().funcionarioId;
    }

    // PONTO 2.0 F0 (P1-05): ninguém usa privilégio administrativo sobre o PRÓPRIO ponto
    // (vale para gestor, admin e dual-role). Sem vínculo de funcionário → nunca é "próprio".
    function naoEhProprioPonto(fid) {
      return fid != meuPerfil().get('funcionarioId', '__sem_vinculo__');
    }

    // ── Funções auxiliares — segurança comercial ───────────────────────────────
    //
    // BILLING IMPORTANTE:
    //   Cada chamada get() / exists() nas Rules conta como leitura Firestore
    //   para fins de faturamento (confirmado desde 2020).
    //   O Firestore faz cache por path único dentro de uma única avaliação de
    //   regras: múltiplos get() ao mesmo documento não multiplicam o custo.
    //   O limite por avaliação é de até 10 acessos a documentos distintos.
    //
    //   isGestor() já lê users/{uid} → 1 leitura faturada (cached por meuPerfil).
    //   isDisplay() lê users/{uid}   → mesma leitura (cached).
    //   temModulo() lê sistema_usuarios/{uid} → 1 leitura adicional faturada.
    //   isDualRoleAtivo() lê users/{uid} + sistema_usuarios/{uid} → 2 leituras.
    //   temAcessoModulo() = isDualRoleAtivo() + get(sistema_usuarios) [cached] → 2 leituras.
    //
    //   Custo real por operação de gestor com módulo verificado: 2 leituras.
    //   No volume atual (< 50k/dia), o custo está dentro do free tier.
    //
    //   ALTERNATIVA SEM CUSTO EXTRA: mover campo modulos[] para users/{uid}.
    //   Isso eliminaria a segunda leitura (meuPerfil() já é cached).
    //   Avaliar migração antes de S5 se o volume aumentar significativamente.
    //
    //   VALIDAR NO EMULATOR antes de qualquer deploy em produção.

    // Conta de display (TV/painel): somente leitura de métricas autorizadas.
    // Requer doc users/{uid} com role='display' e ativo=true.
    // Lê users/{uid} — cached junto com isGestor() se ambos forem avaliados.
    function isDisplay() {
      return isAuthed() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        meuPerfil().role == 'display' &&
        meuPerfil().ativo == true;
    }

    // Verifica se o gestor tem o módulo específico liberado em sistema_usuarios.
    // CUSTO: 1 leitura adicional em sistema_usuarios/{uid} por operação.
    // NÃO chamar em conjunto com isGestor() mais de uma vez por regra
    // para evitar duplicar o documento na contagem de accesses.
    // Módulo ponto: gestores precisam do módulo 'ponto' para acesso às coleções
    // administrativas (funcionarios, registros, espelhos, justificativas,
    // creditos_jornada, avaliacoes). admin=true concede acesso a qualquer módulo
    // sem precisar de entrada explícita em modulos[].
    // users/ e sistema_usuarios/ continuam usando isGestor() (sem temModulo).
    function temModulo(modulo) {
      return isGestor() &&
        exists(/databases/$(database)/documents/sistema_usuarios/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/sistema_usuarios/$(request.auth.uid)).data.get('admin', false) == true ||
         get(/databases/$(database)/documents/sistema_usuarios/$(request.auth.uid)).data.modulos.hasAny([modulo]));
    }

    // ── Dual-role model (P0 fix 2026-09-22) ───────────────────────────────────
    //
    // Identidade administrativa válida para usuários com role='funcionario' que
    // também possuem perfil administrativo em sistema_usuarios.
    //
    // Permite: role=gestor OU role=funcionario com sistema_usuarios válido e não bloqueado.
    // Bloqueia: users/{uid} ausente, inativo, role=display, bloqueado=true, erro.
    //
    // BILLING: 2 leituras (users/{uid} + sistema_usuarios/{uid}).
    //          O Firestore faz cache por path — get() repetidos na mesma avaliação
    //          não são cobrados novamente.
    function isDualRoleAtivo() {
      return isAuthed() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        meuPerfil().ativo == true &&
        (meuPerfil().role == 'gestor' || meuPerfil().role == 'funcionario') &&
        exists(/databases/$(database)/documents/sistema_usuarios/$(request.auth.uid)) &&
        !get(/databases/$(database)/documents/sistema_usuarios/$(request.auth.uid)).data.get('bloqueado', false);
    }

    // Autoriza acesso a módulo administrativo — dual-role aware.
    // Identidade administrativa (gestor ou funcionario+perfil) + módulo liberado.
    // Para ponto: usar temModulo('ponto') || temAcessoModulo('ponto') — dual-role autorizado (P0 fix 2026-09-24).
    // BILLING: 2 leituras (users + sistema_usuarios, cached).
    function temAcessoModulo(modulo) {
      return isDualRoleAtivo() &&
        (get(/databases/$(database)/documents/sistema_usuarios/$(request.auth.uid)).data.get('admin', false) == true ||
         get(/databases/$(database)/documents/sistema_usuarios/$(request.auth.uid)).data.modulos.hasAny([modulo]));
    }

    // Proteção dos campos de integração GestãoClick (adicionado em S1 Fase 1).
    // Esses campos são metadados de vinculação: somente Admin SDK pode criá-los
    // ou modificá-los. O frontend (mesmo gestor autenticado) não pode tocá-los.
    // BILLING: não lê nenhum documento — apenas inspeciona request/resource.data.
    //          Custo zero adicional por operação.
    function gcFieldsIntact() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['gestaoClickId', 'gestaoClickLinkedAt', 'gestaoClickLinkMethod']);
    }

    function noGcFieldsOnCreate() {
      return !request.resource.data.keys()
        .hasAny(['gestaoClickId', 'gestaoClickLinkedAt', 'gestaoClickLinkMethod']);
    }

    // ── Coleção: users ─────────────────────────────────────────────────────────

    match /users/{uid} {
      allow read: if isAuthed() && (request.auth.uid == uid || isGestor());
      allow write: if isGestor();
    }

    // ── Coleção: funcionarios ──────────────────────────────────────────────────

    match /funcionarios/{funcId} {
      allow read:  if temModulo('ponto') || temAcessoModulo('ponto') || (isFuncionario() && funcId == meuFuncId());
      allow write: if temModulo('ponto') || temAcessoModulo('ponto');
    }

    // ── Coleção: registros ─────────────────────────────────────────────────────
    // Funcionários NÃO podem criar registros diretamente.
    // Criação ocorre via Cloud Function registrarPonto (Admin SDK).
    // Gestores podem criar, editar e deletar (lançamento manual, correções).

    match /registros/{regId} {
      allow read:             if temModulo('ponto') || temAcessoModulo('ponto') || (isFuncionario() && resource.data.funcId == meuFuncId());
      // PONTO 2.0 F0 (P0-02): batida original é IMUTÁVEL e não pode ser apagada pelo cliente.
      //   create: lançamento administrativo (ex.: correção aprovada) — nunca do próprio ponto;
      //   update: só marcar a substituição por uma correção, uma única vez, sem tocar hora/tipo/data;
      //   delete: proibido (a trilha fica completa).
      allow create: if (temModulo('ponto') || temAcessoModulo('ponto')) && naoEhProprioPonto(request.resource.data.funcId);
      allow update: if (temModulo('ponto') || temAcessoModulo('ponto')) &&
        naoEhProprioPonto(resource.data.funcId) &&
        !('substituidoPor' in resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['substituidoPor', 'substituidoEm', 'substituidoPorJustificativa']);
      allow delete: if false;
    }

    // ── Coleção: justificativas ────────────────────────────────────────────────

    match /justificativas/{justifId} {
      allow read:   if temModulo('ponto') || temAcessoModulo('ponto') || (isFuncionario() && resource.data.funcId == meuFuncId());
      allow create: if ((temModulo('ponto') || temAcessoModulo('ponto')) && naoEhProprioPonto(request.resource.data.funcId)) || (
        isFuncionario() &&
        request.resource.data.funcId == meuFuncId() &&
        request.resource.data.status == 'pendente' &&
        request.resource.data.lancadoPorGestor == false
      );
      // Identidade: quando gravados, respondidoPorUid/Email devem corresponder ao caller.
      // Server timestamp: respondidoEm deve ser avaliado no momento do servidor (request.time).
      // Imutabilidade: após a resposta, esses três campos não podem ser alterados nem removidos.
      allow update: if (temModulo('ponto') || temAcessoModulo('ponto')) &&
        naoEhProprioPonto(resource.data.funcId) &&                                    // PONTO 2.0 F0 (P1-05)
        naoEhProprioPonto(request.resource.data.funcId) &&
        // PONTO 2.0 F0: decisão só a partir de 'pendente' (impede 2ª aprovação/reversão silenciosa)
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) || resource.data.status == 'pendente') &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['respondidoPorUid']) ||
         request.resource.data.respondidoPorUid == request.auth.uid) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['respondidoPorEmail']) ||
         request.resource.data.respondidoPorEmail == request.auth.token.email) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['respondidoEm']) ||
         request.resource.data.respondidoEm == request.time) &&
        (!('respondidoPorUid'   in resource.data) ||
         ('respondidoPorUid'   in request.resource.data &&
          resource.data.respondidoPorUid   == request.resource.data.respondidoPorUid)) &&
        (!('respondidoPorEmail' in resource.data) ||
         ('respondidoPorEmail' in request.resource.data &&
          resource.data.respondidoPorEmail == request.resource.data.respondidoPorEmail)) &&
        (!('respondidoEm'       in resource.data) ||
         ('respondidoEm'       in request.resource.data &&
          resource.data.respondidoEm       == request.resource.data.respondidoEm));
      allow delete: if (temModulo('ponto') || temAcessoModulo('ponto')) && resource.data.status == 'pendente' && naoEhProprioPonto(resource.data.funcId);
    }

    // ── Coleção: creditos_jornada ──────────────────────────────────────────────

    match /creditos_jornada/{creditoId} {
      allow read:  if temModulo('ponto') || temAcessoModulo('ponto') || (isFuncionario() && resource.data.funcId == meuFuncId());
      // PONTO 2.0 F0 (P1-05): crédito de jornada nunca no próprio ponto
      allow create: if (temModulo('ponto') || temAcessoModulo('ponto')) && naoEhProprioPonto(request.resource.data.funcId);
      allow update: if (temModulo('ponto') || temAcessoModulo('ponto')) && naoEhProprioPonto(resource.data.funcId) && naoEhProprioPonto(request.resource.data.funcId);
      allow delete: if (temModulo('ponto') || temAcessoModulo('ponto')) && naoEhProprioPonto(resource.data.funcId);
    }

    // ── Coleção: espelhos ──────────────────────────────────────────────────────

    match /espelhos/{espelhoId} {
      allow read: if temModulo('ponto') || temAcessoModulo('ponto') || (isFuncionario() && resource.data.funcId == meuFuncId());

      // Gestor/dual-role cria: espelho sempre nasce não-assinado.
      allow create: if (temModulo('ponto') || temAcessoModulo('ponto')) && request.resource.data.assinado == false && naoEhProprioPonto(request.resource.data.funcId);

      // Gestor atualiza:
      //   Campos estruturais (funcId, mes, versao, versaoAnteriorId) são imutáveis após create.
      //   Espelho não-assinado: snapshot/hash/status/revisão podem ser atualizados.
      //   Espelho assinado: snapshot, hash e campos de assinatura são imutáveis.
      //   Finalização de v1 (revisaoEmAndamento/substituido) é feita pela Cloud Function (Admin SDK).
      allow update: if (temModulo('ponto') || temAcessoModulo('ponto')) &&
        naoEhProprioPonto(resource.data.funcId) &&                                    // PONTO 2.0 F0 (P1-05)
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['funcId', 'mes', 'versao', 'versaoAnteriorId', 'hashAssinado']) &&   // hashAssinado: só o funcionário, ao assinar
        (
          !resource.data.assinado ||
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['snapshot', 'hashSnapshot', 'assinado', 'assinaturaImg', 'assinadoEm', 'assinadoPor'])
        );

      // Funcionário assina espelho próprio:
      //   - Somente espelhos não-assinados (transição false → true).
      //   - assinadoEm deve ser serverTimestamp() — não aceitamos timestamp do cliente.
      //   - Espelho deve ter snapshot e hash antes de poder ser assinado.
      //   - Se status for enviado, deve ser 'assinado'.
      //   - Somente os campos de assinatura podem ser alterados.
      //   - PONTO 2.0 SIGNED_SNAPSHOT: hashAssinado (hash do espelho que o funcionário viu) deve ser igual ao
      //     hashSnapshot atual do documento → se o gestor reenviar outra versão no meio, a assinatura é recusada.
      allow update: if isFuncionario() &&
        resource.data.funcId == meuFuncId() &&
        !resource.data.assinado &&
        resource.data.snapshot != null &&
        resource.data.hashSnapshot != null &&
        request.resource.data.assinado == true &&
        request.resource.data.assinadoEm == request.time &&
        request.resource.data.hashAssinado == resource.data.hashSnapshot &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['assinado', 'assinaturaImg', 'assinadoEm', 'assinadoPor', 'status', 'hashAssinado']) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) ||
          request.resource.data.status == 'assinado');

      // Gestor/dual-role exclui: apenas espelhos não assinados.
      allow delete: if (temModulo('ponto') || temAcessoModulo('ponto')) && !resource.data.assinado && naoEhProprioPonto(resource.data.funcId);
    }

    // ── Coleção: avaliacoes ────────────────────────────────────────────────────

    match /avaliacoes/{avalId} {
      allow read, write: if temModulo('ponto') || temAcessoModulo('ponto');
    }

    // ── Coleção: sistema_usuarios ──────────────────────────────────────────────
    // Perfis de acesso ao sistema administrativo (modulos/permissoes por gestor).
    // Self-read: qualquer usuário autenticado pode ler o próprio perfil
    // (necessário para dual-role: funcionario lê seus próprios módulos).

    match /sistema_usuarios/{uid} {
      allow read: if isAuthed() && (request.auth.uid == uid || isGestor());
      allow write: if isGestor();
    }

    // ── Coleção: produto_equivalentes ──────────────────────────────────────────

    match /produto_equivalentes/{docId} {
      allow read, write: if isGestor() || temAcessoModulo('equivalentes');
    }

    // ── Coleção: demandas ──────────────────────────────────────────────────────

    match /demandas/{demandaId} {
      allow read, write: if isGestor() || temAcessoModulo('demandas');
    }

    // ── Coleção: painel_config ─────────────────────────────────────────────────
    // Configurações do painel — leitura e escrita restritas a gestores.

    match /painel_config/{configId} {
      allow read, write: if isGestor();
    }

    // ── Coleção: compras_config ────────────────────────────────────────────────
    // Configurações do módulo de compras (settings, fornecedores, mapeamento).

    match /compras_config/{docId} {
      allow read, write: if isGestor() || temAcessoModulo('compras');
    }

    // ── AGENTE COMPRAS & ESTOQUE MR4 — Fase 0 (motor determinístico) ─────────────────────────
    // Escrita só pelo sync server-side (Admin SDK). Menor privilégio:
    //   operacional (produto, saldo, velocidade, cobertura, ruptura, reposição, sugestão; SEM custo/faturamento):
    //     módulo 'estoque' (gestor ou funcionário ativo, não bloqueado) — compras_n0/{resumo,meta}, compras_n0_produtos
    //   custo / faturamento / valor de estoque: GESTOR + (admin | módulo 'estoque'), não bloqueado — compras_n0_custos
    //   histórico de saldo (estoque_snapshots): módulo 'estoque' · base do incremental (compras_n0_base): ninguém
    match /compras_n0/{docId} {
      allow read:  if docId in ['resumo', 'meta'] && temAcessoModulo('estoque');
      allow write: if false;
    }
    match /compras_n0_produtos/{blocoId} {
      allow read:  if temAcessoModulo('estoque');
      allow write: if false;
    }
    match /compras_n0_custos/{blocoId} {
      allow read:  if temModulo('estoque') && naoBloqueado();
      allow write: if false;
    }
    // snapshot COMPLETO diário do saldo bruto (dia comercial America/Fortaleza); docId = YYYY-MM-DD
    match /estoque_snapshots/{dia} {
      allow read:  if dia.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && temAcessoModulo('estoque');
      allow write: if false;
    }
    // base compacta do sync incremental (itens de venda/compra com valores, SEM cliente): só o Admin SDK
    match /compras_n0_base/{docId} {
      allow read, write: if false;
    }
    // visão da TELA de Compras (já processada no servidor): sugestoes = operacional (SEM custo) · custos = só gestor
    match /compras_n0_view/{docId} {
      allow read:  if (docId == 'sugestoes' && temAcessoModulo('estoque')) ||
                      (docId == 'custos'    && temModulo('estoque') && naoBloqueado());
      allow write: if false;
    }
    // registro de execuções do sync (só metadados seguros): gestor com módulo estoque (ou admin)
    match /compras_n0_runs/{runId} {
      allow read:  if temModulo('estoque') && naoBloqueado();
      allow write: if false;
    }

    // ── Coleção: expedicao_pedidos ─────────────────────────────────────────────
    // Pedidos do módulo de expedição. Frontend filtra por sistema_usuarios.modulos.

    // P0 (máquina de estados): coluna só muda por transição válida, com compare-and-set de versão e evento de
    // auditoria no MESMO commit. Espelha js/expedicao-core.js. Escrita antiga (setDoc/merge sem protocolo, de abas
    // abertas antes da atualização) é RECUSADA — não consegue regredir nem sobrescrever pedido.
    //   Fluxo: ag → se → pr → de · Cancelar: ag|se|pr → cancelado · de e cancelado terminais
    //   Reabrir (de → ag): só gestor, motivo 5–200 caracteres, auditado.
    function expAcesso() {
      return isGestor() || temAcessoModulo('expedicao');
    }
    function isValidExpeditionTransition(de, para) {
      return (de == 'ag' && para == 'se') || (de == 'se' && para == 'pr') || (de == 'pr' && para == 'de') ||
             (de in ['ag', 'se', 'pr'] && para == 'cancelado');
    }
    function expEnvioValido(e) {
      return e in ['uber-mr4', 'uber-cliente', 'retirada', 'retirada-terc', 'rota-manha', 'rota-tarde'];
    }
    // horário informado pelo navegador (ms) precisa estar a ±10 min do relógio do servidor
    function expMsOk(ms) {
      return ms is int && ms > request.time.toMillis() - 600000 && ms < request.time.toMillis() + 600000;
    }
    function expSoMudou(extras) {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['coluna', 'versao', 'ultimoEventoId', 'atualizadoEm', 'atualizadoPor', 'movidoEm'].concat(extras));
    }
    // compare-and-set: versão = atual + 1, evento v{versão} criado no mesmo commit, carimbo e autor do servidor
    function expProtocolo(pedidoId) {
      let v = resource.data.get('versao', 0) + 1;
      let n = request.resource.data;
      return n.versao == v && n.ultimoEventoId == 'v' + string(v) &&
             n.atualizadoEm == request.time && n.atualizadoPor == request.auth.uid && expMsOk(n.movidoEm) &&
             existsAfter(/databases/$(database)/documents/expedicao_pedidos/$(pedidoId)/eventos/$('v' + string(v)));
    }
    function expTransicaoOk() {
      let de = resource.data.coluna;
      let n = request.resource.data;
      return (isValidExpeditionTransition(de, n.coluna) && (
                (de == 'ag' && n.coluna == 'se' && expSoMudou(['envio']) && expEnvioValido(n.envio)) ||
                (de == 'se' && n.coluna == 'pr' && expSoMudou([])) ||
                (de == 'pr' && n.coluna == 'de' && expSoMudou(['envio', 'saidaEm']) && expEnvioValido(n.envio) && expMsOk(n.saidaEm)) ||
                (n.coluna == 'cancelado' && expSoMudou(['canceladoEm']) && expMsOk(n.canceladoEm))
             )) ||
             (de == 'de' && n.coluna == 'ag' && isGestor() &&
                expSoMudou(['envio', 'saidaEm', 'ingresadoEm', 'reabertura']) &&
                n.envio == null && n.saidaEm == null && expMsOk(n.ingresadoEm) &&
                n.reabertura.keys().hasOnly(['motivo', 'por', 'em']) && n.reabertura.motivo is string &&
                n.reabertura.motivo.size() >= 5 && n.reabertura.motivo.size() <= 200 &&
                n.reabertura.por == request.auth.uid && n.reabertura.em == request.time);
    }
    // criação: só 'ag', só se o documento NÃO existe (create), com o formato conhecido; nunca sobrescreve
    function expCriacaoOk(pedidoId) {
      let n = request.resource.data;
      return n.coluna == 'ag' && n.numero == pedidoId && n.envio == null && n.saidaEm == null &&
             n.keys().hasOnly(['numero', 'data', 'hora', 'ingresadoEm', 'movidoEm', 'coluna', 'cliente', 'vendedor',
                               'itens', 'valor', 'cidade', 'envio', 'saidaEm', 'versao', 'ultimoEventoId', 'criadoEm', 'origem']) &&
             n.get('versao', 0) == 0;
    }

    match /expedicao_pedidos/{pedidoId} {
      allow read:   if expAcesso();
      allow create: if expAcesso() && expCriacaoOk(pedidoId);
      allow update: if expAcesso() && expProtocolo(pedidoId) && expTransicaoOk();
      allow delete: if false;

      // trilha imutável de transições: eventos/v{versão}, criada no mesmo commit da transição
      match /eventos/{eventoId} {
        allow read:   if expAcesso();
        allow create: if expAcesso() && expEventoOk(pedidoId, eventoId);
        allow update, delete: if false;
      }
    }
    function expEventoOk(pedidoId, eventoId) {
      let antes = get(/databases/$(database)/documents/expedicao_pedidos/$(pedidoId)).data;
      let depois = getAfter(/databases/$(database)/documents/expedicao_pedidos/$(pedidoId)).data;
      let e = request.resource.data;
      return depois.ultimoEventoId == eventoId && depois.versao == antes.get('versao', 0) + 1 &&
             e.keys().hasOnly(['pedido', 'de', 'para', 'acao', 'versao', 'em', 'por', 'origem', 'motivo']) &&
             e.pedido == pedidoId && e.de == antes.coluna && e.para == depois.coluna && e.versao == depois.versao &&
             e.em == request.time && e.por == request.auth.uid &&
             e.acao in ['INICIAR_SEPARACAO', 'MARCAR_SEPARADO', 'DESPACHAR', 'CANCELAR', 'REABRIR'];
    }

    // estado do sync central de pedidos novos (escrito só pela Function expedicaoSyncPedidos, Admin SDK)
    match /expedicao_sync/{docId} {
      allow read:  if expAcesso();
      allow write: if false;
    }

    // ── Coleções: marketing ────────────────────────────────────────────────────
    // Conteúdos de pipeline, ideias e legendas do módulo de marketing.

    match /marketing_conteudos/{docId} {
      allow read, write: if isGestor() || temAcessoModulo('marketing');
    }

    match /marketing_ideias/{docId} {
      allow read, write: if isGestor() || temAcessoModulo('marketing');
    }

    match /marketing_legendas/{docId} {
      allow read, write: if isGestor() || temAcessoModulo('marketing');
    }

    // ── Coleção: garantias ─────────────────────────────────────────────────────
    // Registros de garantia de produtos.

    match /garantias/{garantiaId} {
      allow read, write: if isGestor() || temAcessoModulo('garantia');
    }

    // ── Coleção: fornecedores_custo ────────────────────────────────────────────
    // Tabela de fornecedores com percentuais de custo.
    // Usada em garantia.html (read). Escrita restrita a gestores (dado sensível).

    match /fornecedores_custo/{fornecedorId} {
      allow read:  if isGestor() || temAcessoModulo('garantia');
      allow write: if isGestor();
    }

    // ── Coleção: clientes ──────────────────────────────────────────────────────
    // CRM — cadastro de clientes. Pipeline, notas, histórico de contato.
    //
    // Campos protegidos contra write pelo frontend (S1 Fase 1):
    //   gestaoClickId, gestaoClickLinkedAt, gestaoClickLinkMethod
    //   Apenas Admin SDK pode criar/modificar esses campos.
    //   O Admin SDK ignora Rules — proteção só afeta chamadas de cliente.

    match /clientes/{clienteId} {
      allow read:   if isGestor() || temAcessoModulo('clientes');
      allow create: if (isGestor() || temAcessoModulo('clientes')) && noGcFieldsOnCreate();
      allow update: if (isGestor() || temAcessoModulo('clientes')) && gcFieldsIntact();
      allow delete: if isGestor() || temAcessoModulo('clientes');
    }

    // ── Coleção: conversas (e subcoleção msgs) ─────────────────────────────────
    // Histórico de conversas do CRM por telefone.
    // conversas/{phone} — documento raiz (metadados, se existir).
    // conversas/{phone}/msgs/{msgId} — mensagens da conversa.

    match /conversas/{phone} {
      allow read, write: if isGestor() || temAcessoModulo('clientes');
      match /msgs/{msgId} {
        allow read, write: if isGestor() || temAcessoModulo('clientes');
      }
    }

    // ── Coleção: conversas_resumo ──────────────────────────────────────────────
    // Resumos de conversas para exibição no painel de inbox.

    match /conversas_resumo/{phone} {
      allow read, write: if isGestor() || temAcessoModulo('clientes');
    }

    // ── Coleção: chat_status ───────────────────────────────────────────────────
    // Status de conexão do WhatsApp por número de telefone.

    match /chat_status/{phone} {
      allow read, write: if isGestor() || temAcessoModulo('clientes');
    }

    // ── Coleção: display_metrics ───────────────────────────────────────────────
    // Métricas para o painel de TV. Escrita APENAS via Admin SDK (sync).
    // Leitura: role=display (TV) ou gestor. Browser sem users/{uid}+role=display → DENIED.

    match /display_metrics/{docId} {
      allow read:  if isDisplay() || isGestor();
      allow write: if false;
    }

    // ── Coleção: gc_audit ─────────────────────────────────────────────────────
    // Log de auditoria de operações de escrita no GestãoClick.
    // ATUALIZAR_PRECO removida (Calculadora de Custo eliminada). Coleção mantida para histórico.
    // Escrita APENAS via Admin SDK (gcQuery server-side). Leitura apenas gestor.

    match /gc_audit/{docId} {
      allow read:  if isGestor();
      allow write: if false;
    }

    // ── Coleção: financeiro_cache ──────────────────────────────────────────────
    // Cache financeiro (contas vencidas/vencendo). Escrita APENAS via Admin SDK.
    // Substitui data/financeiro.json (público) — adicionada em S1.
    // BILLING: temAcessoModulo() = 2 leituras (users + sistema_usuarios).

    match /financeiro_cache/{docId} {
      allow read:  if temAcessoModulo('financeiro');
      allow write: if false;
    }

    // ── Coleção: painel_cache (SECURITY HOTFIX P0 — substitui data/*.json públicos) ─────────
    // Gravada somente pelo sync (Admin SDK). Leitura por documento, com menor privilégio:
    //   vendas            → faturamento, metas, faturamento por vendedor: gestor + (admin | módulo vendas)
    //   caixa             → só o faturamento do dia (Caixa Diário):         gestor + (admin | módulo caixa)
    //   estoque           → operacional, sem custo/preço (reposição, giro):  módulo estoque (gestor ou funcionário)
    //   estoque_custos    → valor do estoque, custo, preço e margem:         gestor + (admin | módulo estoque)
    //   produtos_catalogo → id/código/nome/fabricante (autocomplete):        módulo estoque (gestor ou funcionário)
    // Qualquer outro docId: negado. Ser "gestor" sozinho não basta (exige sistema_usuarios não bloqueado).
    // temModulo() não olha o bloqueio; naoBloqueado() completa (usado só depois de temModulo, que já exige o doc).
    function naoBloqueado() {
      return !get(/databases/$(database)/documents/sistema_usuarios/$(request.auth.uid)).data.get('bloqueado', false);
    }
    match /painel_cache/{docId} {
      allow read: if
        (docId == 'vendas'            && temModulo('vendas')           && naoBloqueado()) ||
        (docId == 'caixa'             && temModulo('caixa')            && naoBloqueado()) ||
        (docId == 'estoque'           && temAcessoModulo('estoque'))                       ||
        (docId == 'estoque_custos'    && temModulo('estoque')          && naoBloqueado()) ||
        (docId == 'produtos_catalogo' && temAcessoModulo('estoque'));
      allow write: if false;
    }

    // ── Coleção: pedidos_cache ─────────────────────────────────────────────────
    // Cache de pedidos para expedição. Escrita APENAS via Admin SDK.
    // Substitui data/pedidos.json (público) — adicionada em S1.
    // Dados sanitizados (CPF/cadastro removidos) antes da escrita no sync.
    // BILLING: temAcessoModulo() = 2 leituras (users + sistema_usuarios).

    match /pedidos_cache/{docId} {
      allow read:  if temAcessoModulo('expedicao');
      allow write: if false;
    }

    // ── perfis_360 — leitura por gestor; escrita somente Admin SDK (sync CI/CD) ──
    match /perfis_360/{clienteId} {
      allow read: if isGestor();
      allow write: if false;
    }

    // ── vendas_gc — espelho interno de vendas GC; sem acesso pelo frontend ───────
    // Admin SDK (sync CI/CD) ignora Rules e escreve sem restrição.
    match /vendas_gc/{vendaId} {
      allow read, write: if false;
    }

    // ── sync_state — cursor e status do sync360; sem acesso pelo frontend ────────
    match /sync_state/{docId} {
      allow read, write: if false;
    }

    // ── Coleção: fila_comercial ───────────────────────────────────────────────
    // Snapshot VIEW MODEL da Fila Comercial (N34 Phase E).
    // Escrita APENAS via Admin SDK (Cloud Function pipeline). Frontend: somente leitura.
    // Conteúdo: já sanitizado por prepararDadosUI() — sem CAMPOS_BLOQUEADOS.
    // BILLING: temModulo() = 2 leituras (users + sistema_usuarios).

    // N35.12S: operar = vendedores (funcionario+operar); gestao = Camila (funcionario+gestao); gestores = isGestor().
    match /fila_comercial/{docId} {
      allow read:  if isGestor() || temAcessoModulo('fila-comercial-operar') || temAcessoModulo('fila-comercial-gestao');
      allow write: if false;
    }

    // ── Coleção: fila_comercial_gestao (N35.20.1) ─────────────────────────────
    // Dados EXCLUSIVOS de gestão da Worklist (ex.: ticket médio), chave opportunityInstanceId, sem PII.
    // Vendedor (fila-comercial-operar) NUNCA lê — por isso fica FORA de fila_comercial/{docId}.
    // Leitura: role gestor (isGestor) OU módulo 'fila-comercial-gestao' EXPLÍCITO.
    // SEM atalho admin=true (temAcessoModulo concede tudo a admin; aqui não se aplica).
    // Escrita APENAS via Admin SDK (Cloud Function gerarWorklistDiaria).
    function temModuloGestaoFilaExplicito() {
      return isDualRoleAtivo() &&
        get(/databases/$(database)/documents/sistema_usuarios/$(request.auth.uid)).data.get('modulos', []).hasAny(['fila-comercial-gestao']);
    }
    match /fila_comercial_gestao/{docId} {
      allow read:  if isGestor() || temModuloGestaoFilaExplicito();
      allow write: if false;
    }

    // ── Coleção: carteira_comercial (N35.26 — publicada para a Onda 1) ──
    // Vínculo estrutural cliente → vendedor responsável, SEPARADO de worklist/claim/transferência.
    // Gestão lê tudo; vendedor (operar EXPLÍCITO, sem atalho admin) lê só documentos da própria carteira.
    // Escrita APENAS via Admin SDK (migração controlada da N35.26; nenhuma escrita pelo cliente/navegador).
    function temModuloOperarFilaExplicito() {
      return isDualRoleAtivo() &&
        get(/databases/$(database)/documents/sistema_usuarios/$(request.auth.uid)).data.get('modulos', []).hasAny(['fila-comercial-operar']);
    }
    match /carteira_comercial/{entidadeId} {
      allow read:  if isGestor() || temModuloGestaoFilaExplicito() ||
                   (temModuloOperarFilaExplicito() && resource.data.ownerUid == request.auth.uid);
      allow write: if false;
    }
    match /carteira_comercial_historico/{eventoId} {
      allow read:  if isGestor() || temModuloGestaoFilaExplicito();
      allow write: if false;
    }

    // ── Coleção: interacoes_fila (N35.10/N35.12/N35.12S) ─────────────────────
    // Estado operacional canário da Fila Comercial.
    // Escrita APENAS via Admin SDK (Cloud Function). Frontend: somente leitura.
    // N35.12S: gestores leem via isGestor(); vendedores via operar; supervisão via gestao.
    match /interacoes_fila/{oppId} {
      allow read:  if isGestor() || temAcessoModulo('fila-comercial-operar') || temAcessoModulo('fila-comercial-gestao');
      allow write: if false;
    }

    // ── Tudo mais: negado por padrão ───────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
