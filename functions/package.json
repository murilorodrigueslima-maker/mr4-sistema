{
  "name": "mr4-ponto-functions",
  "version": "1.0.0",
  "description": "Cloud Functions — MR4 Ponto Digital",
  "main": "index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "test": "jest --testPathPattern=test/ --forceExit --runInBand",
    "test:rules": "jest --testPathPattern=rules.test --forceExit",
    "test:unit": "jest --testPathPattern=functions.unit.test --forceExit",
    "test:e2e": "jest --testPathPattern=emulator.e2e.test --forceExit --testTimeout=60000",
    "test:timezone": "jest --testPathPattern=timezone.test --forceExit"
  },
  "dependencies": {
    "firebase-admin": "^12.3.0",
    "firebase-functions": "^6.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase-tools": "^13.13.0",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000
  },
  "private": true
}
